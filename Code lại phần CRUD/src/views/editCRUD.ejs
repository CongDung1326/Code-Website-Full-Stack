<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit's CRUD</title>
</head>
<style>
    * {
        font-family: sans-serif;
    }

    table {
        width: 100%;
    }

    table,
    td,
    th {
        border: 1px solid;
        border-collapse: collapse;
        padding: 10px;
    }

    a {
        outline: none;
        border: none;
        padding: 5px;
        border-radius: 5px;
        color: white;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-edit {
        background: orange;
    }

    .btn-delete {
        background: red;
    }

    .button__add {
        text-align: right;
        margin-top: 20px;
    }

    .btn-add {
        background: green;
        padding: 10px;
    }
</style>

<body>
    <table>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
        <% for(let i=0 ; i < dataTable.length ; i++) { %>
            <tr>
                <td>
                    <%= dataTable[i].firstName %>
                </td>
                <td>
                    <%= dataTable[i].lastName %>
                </td>
                <td>
                    <%= dataTable[i].address %>
                </td>
                <td>
                    <a href="/edit-crud-infomation?id=<%= dataTable[i].id %>" class="btn-edit">Edit</a>
                    <a href="/delete-crud?id=<%= dataTable[i].id %>" class="btn-delete">Delete</a>
                </td>
            </tr>
            <% } %>
    </table>
    <div class="button__add">
        <a href="/crud" class="btn-add">Add</a>
    </div>
</body>

</html>